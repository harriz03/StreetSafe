<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:map="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6FBF7">

    <!-- TOP HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        android:background="#F6FBF7">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="←"
            android:textSize="18sp"
            android:textColor="#2E7D32"
            android:backgroundTint="#E8F5E9"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Safe Route"
                android:textColor="#1B5E20"
                android:textStyle="bold"
                android:textSize="24sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Find safer roads around high-risk areas"
                android:textColor="#6B8E72"
                android:textSize="13sp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- INPUT CONTAINER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:padding="18dp">

        <!-- START -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Starting Point"
            android:textColor="#4E6E56"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/editOrigin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Choose your location"
            android:focusable="false"
            android:clickable="true"
            android:padding="14dp"
            android:backgroundTint="#C8E6C9"
            android:textColor="#1B1B1B"/>

        <!-- LOCATION BUTTON -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUseMyLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="📍 Use My Current Location"
            android:textAllCaps="false"
            android:textColor="#2E7D32"
            android:backgroundTint="#E8F5E9"/>

        <!-- DESTINATION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Destination"
            android:textColor="#4E6E56"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/editDestination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Where are you going?"
            android:focusable="false"
            android:clickable="true"
            android:padding="14dp"
            android:backgroundTint="#C8E6C9"
            android:textColor="#1B1B1B"/>

        <!-- FIND BUTTON -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFindRoute"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:text="Find Safe Route"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"/>

        <!-- LOADING -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- RESULT CARD -->
    <TextView
        android:id="@+id/txtRouteResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="18dp"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:text="Your suggested route will appear here"
        android:textColor="#2F4F35"
        android:textSize="14sp"/>

    <!-- MAP -->
    <fragment
        android:id="@+id/safeRouteMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"/>

</LinearLayout>