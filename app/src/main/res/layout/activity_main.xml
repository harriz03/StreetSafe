<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4FAF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_top_panel"
        android:gravity="center_horizontal|center_vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="52dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_icon_circle"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/shield_icon"
                android:contentDescription="@string/desc_shield_icon"
                app:tint="#FFFFFF" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.03"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/txtTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tagline"
            android:textSize="13sp"
            android:textColor="#C8E6C9"
            android:letterSpacing="0.04" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_form_card"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="-20dp"
        android:layout_marginBottom="24dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="28dp"
        android:elevation="6dp">

        <TextView
            android:id="@+id/txtWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_sign_in_heading"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/txtLabelUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_email"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:letterSpacing="0.10"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_input_field_enhanced"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_input_accent" />

            <EditText
                android:id="@+id/editUsername"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:minHeight="56dp"
                android:hint="@string/hint_email"
                android:textColor="#1B5E20"
                android:textColorHint="#78909C"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="text"
                android:autofillHints="username"
                android:background="@android:color/transparent" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtLabelPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_password"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:letterSpacing="0.10"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_input_field_enhanced"
            android:layout_marginBottom="28dp">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_input_accent" />

            <EditText
                android:id="@+id/editPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:minHeight="56dp"
                android:hint="@string/hint_password"
                android:textColor="#1B5E20"
                android:textColorHint="#78909C"
                android:fontFamily="sans-serif"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="textPassword"
                android:autofillHints="password"
                android:background="@android:color/transparent" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="56dp"
            android:gravity="center"
            android:textAllCaps="false"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="@string/btn_sign_in"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:letterSpacing="0.08"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@null"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#E8F5E9" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_or_divider"
                android:textSize="11sp"
                android:textColor="#546E7A"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#E8F5E9" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSignUp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="56dp"
            android:gravity="center"
            android:textAllCaps="false"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="@string/btn_create_account"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:letterSpacing="0.05"
            android:background="@drawable/bg_button_secondary"
            android:stateListAnimator="@null" />

    </LinearLayout>

</LinearLayout>