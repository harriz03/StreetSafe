<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reportRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FAF5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Green header ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_top_panel"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="56dp"
            android:paddingBottom="40dp"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/shield_icon"
                    android:contentDescription="@string/desc_shield_icon"
                    app:tint="#FFFFFF"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/report_screen_tagline"
                android:textColor="#C8E6C9"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- ── Form card ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_form_card"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-20dp"
            android:layout_marginBottom="24dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="32dp"
            android:paddingBottom="28dp"
            android:elevation="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/report_heading"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:layout_marginBottom="24dp"/>

            <!-- ── INCIDENT TYPE ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_incident_type"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:letterSpacing="0.10"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_input_field_enhanced"
                android:layout_marginBottom="20dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input_accent"/>

                <Spinner
                    android:id="@+id/spinnerIncidentType"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#1B5E20"
                    android:background="@android:color/transparent"/>

            </LinearLayout>

            <!-- ── LOCATION ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_location"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:letterSpacing="0.10"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_input_field_enhanced"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input_accent"/>

                <EditText
                    android:id="@+id/editLocation"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Tap to search for a location…"
                    android:textColor="#1B5E20"
                    android:textColorHint="#78909C"
                    android:textSize="14sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:inputType="none"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:cursorVisible="false"
                    android:background="@android:color/transparent"/>

            </LinearLayout>

            <!-- Use My Location button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnUseMyLocation"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📍 Use My Location"
                android:textSize="12sp"
                android:textColor="#1B5E20"
                android:background="@drawable/bg_button_secondary"
                android:stateListAnimator="@null"
                android:layout_marginBottom="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>

            <!-- ── DESCRIPTION ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_description"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:letterSpacing="0.10"
                android:layout_marginBottom="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_input_field_enhanced"
                android:layout_marginBottom="24dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input_accent"/>

                <EditText
                    android:id="@+id/editDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/hint_description"
                    android:textColor="#1B5E20"
                    android:textColorHint="#78909C"
                    android:textSize="15sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:minHeight="100dp"
                    android:inputType="textMultiLine"
                    android:gravity="top"
                    android:background="@android:color/transparent"/>

            </LinearLayout>

            <!-- ── PHOTO EVIDENCE ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PHOTO EVIDENCE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:letterSpacing="0.10"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/txtPhotoHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="At least one photo is required to submit a report."
                android:textSize="12sp"
                android:textColor="#78909C"
                android:layout_marginBottom="10dp"/>

            <!-- Photo preview — hidden until a photo is chosen -->
            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:background="#E8F5E9"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                android:contentDescription="Selected photo preview"/>

            <!-- Add Photo button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAddPhoto"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="📷 Add Photo"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:letterSpacing="0.05"
                android:background="@drawable/bg_button_secondary"
                android:stateListAnimator="@null"
                android:layout_marginBottom="24dp"/>

            <!-- Upload progress bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone"
                android:layout_marginBottom="16dp"
                android:progressTint="#2E7D32"
                android:progressBackgroundTint="#C8E6C9"/>

            <!-- Submit button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmitReport"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/btn_submit_report"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:letterSpacing="0.08"
                android:background="@drawable/bg_button_primary"
                android:stateListAnimator="@null"
                android:layout_marginBottom="16dp"/>

            <!-- Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E8F5E9"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_or_divider"
                    android:textSize="11sp"
                    android:textColor="#546E7A"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E8F5E9"/>

            </LinearLayout>

            <!-- Back button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBackFromReport"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/btn_back"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:letterSpacing="0.05"
                android:background="@drawable/bg_button_secondary"
                android:stateListAnimator="@null"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>